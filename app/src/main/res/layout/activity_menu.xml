<?xml version="1.0" encoding="utf-8"?>
<!-- Two audiences. The wearer, who reaches all of this by voice and never looks at it, and someone
     holding the phone for the first time who needs to know what four modes do without being told.
     So each row explains itself, and nothing on the screen is decoration. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none"
    android:fitsSystemWindows="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:focusableInTouchMode="true"
      android:paddingStart="28dp"
      android:paddingEnd="28dp"
      android:paddingTop="72dp"
      android:paddingBottom="44dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The Eye"
        android:textColor="@color/text"
        android:textSize="40sp"
        android:textStyle="bold"
        android:letterSpacing="-0.045"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="44dp"
        android:text="Turns depth into speech and vibration, and says so out loud when it cannot see."
        android:textColor="@color/text_muted"
        android:textSize="16sp"
        android:lineSpacingExtra="5dp"/>

    <View style="@style/Hairline"/>

    <LinearLayout android:id="@+id/card_guardian" style="@style/ModeRow">
      <View android:id="@+id/bar_guardian" style="@style/ModeBar"/>
      <LinearLayout style="@style/ModeText">
        <TextView android:id="@+id/title_guardian" style="@style/ModeTitle" android:text="Guardian"/>
        <TextView style="@style/ModeBody"
            android:text="The nearest thing inside a body-sized corridor, named and measured."/>
      </LinearLayout>
    </LinearLayout>

    <View style="@style/Hairline"/>

    <LinearLayout android:id="@+id/card_aperture" style="@style/ModeRow">
      <View android:id="@+id/bar_aperture" style="@style/ModeBar"/>
      <LinearLayout style="@style/ModeText">
        <TextView android:id="@+id/title_aperture" style="@style/ModeTitle" android:text="Aperture"/>
        <TextView style="@style/ModeBody"
            android:text="Where there is room, and whether your shoulders fit through it."/>
      </LinearLayout>
    </LinearLayout>

    <View style="@style/Hairline"/>

    <LinearLayout android:id="@+id/card_scene" style="@style/ModeRow">
      <View android:id="@+id/bar_scene" style="@style/ModeBar"/>
      <LinearLayout style="@style/ModeText">
        <TextView android:id="@+id/title_scene" style="@style/ModeTitle" android:text="Scene"/>
        <TextView style="@style/ModeBody"
            android:text="Ask what is in front of you and whether to walk."/>
      </LinearLayout>
    </LinearLayout>

    <View style="@style/Hairline"/>

    <LinearLayout android:id="@+id/card_auto" style="@style/ModeRow">
      <View android:id="@+id/bar_auto" style="@style/ModeBar"/>
      <LinearLayout style="@style/ModeText">
        <TextView android:id="@+id/title_auto" style="@style/ModeTitle" android:text="Auto"/>
        <TextView style="@style/ModeBody"
            android:text="Picks between the others every frame, from how sure each one is."/>
      </LinearLayout>
    </LinearLayout>

    <View style="@style/Hairline"/>

    <TextView
        android:id="@+id/start_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_primary"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:text="START"
        android:textColor="#08210F"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.14"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Say a mode name to switch at any time. Say look to be told what is ahead."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Wear it at chest or forehead height, camera forward, tilted about 25 degrees down. Held level, the camera looks straight over anything shorter than you."
        android:textColor="#5C5C66"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"/>

  </LinearLayout>
</ScrollView>
